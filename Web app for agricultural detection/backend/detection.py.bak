# Case-insensitive accessor
_HF_TO_CLASS: dict[str, str] = {k.lower().strip(): v for k, v in _HF_TO_CLASS_RAW.items()}

# Mapping COCO class name → Vietnamese (fallback khi HF không khả dụng)
# CHỈ những class COCO là nông sản mới có trong đây — các class khác (vase, bottle, person…) bị DROP
_COCO_TO_CLASS: dict[str, str] = {
    "banana":    "chuoi",
    "orange":    "cam",
    "apple":     "tao",
    "carrot":    "ca_rot",
    "broccoli":  "bong_cai_xanh",
}

# Whitelist: tập các COCO class được coi là "có thể là nông sản".
# YOLO11n COCO có: banana, apple, orange, carrot, broccoli, pizza, sandwich, cake, donut, hot dog.
# Chỉ giữ cái thực sự là nông sản (tương ứng với _COCO_TO_CLASS).
_COCO_AGRI_WHITELIST: set[str] = set(_COCO_TO_CLASS.keys())

